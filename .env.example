# ==================================================
# BloodLink Backend - Environment Variables
# ==================================================

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB Atlas
MONGODB_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# URLs
CLIENT_URL=https://bloodlink.tech
ADMIN_URL=https://admin.bloodlink.tech
API_URL=https://api.bloodlink.tech

# Resend - Email Service
RESEND_API_KEY=
EMAIL_FROM=BloodLink <noreply@bloodlink.tech>

# Firebase Admin - FCM Push Notification
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary - Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 - Voice/APK/File Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# OTP
OTP_EXPIRES_IN_MINUTES=10

# Matching Engine
DEFAULT_SEARCH_RADIUS_KM=10
MAX_SEARCH_RADIUS_KM=100
DONATION_COOLDOWN_DAYS=90

# Admin authentication and optional two-factor authentication
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_TOTP_ENCRYPTION_KEY=
