# ---- Server ----
NODE_ENV=development
PORT=5000
PUBLIC_API_URL=https://api.bloodlink.tech

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/bloodlink

# ---- JWT Auth ----
JWT_ACCESS_SECRET=change_this_access_secret_key
JWT_REFRESH_SECRET=change_this_refresh_secret_key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ---- Password Hash ----
BCRYPT_SALT_ROUNDS=12

# ---- Resend Email ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@bloodlink.tech

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Firebase Admin SDK for FCM ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- CORS Origins - comma separated ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Sentry Monitoring - optional ----
SENTRY_DSN=
